<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds may talk plain HTTP to a Vaultwarden running on the development machine (the emulator reaches it
  as 10.0.2.2, or 127.0.0.1 through `adb reverse`). Release builds keep Android's default: HTTPS only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
