<?xml version="1.0" encoding="utf-8"?>
<!--
  App icon: a lemon pinched at the waist (being squeezed), dripping juice, with a terminal prompt on it.
  Drawn on the 108dp adaptive-icon canvas; everything stays inside the 66dp safe circle around (54,54).
  The lemon is drawn upright in its own group, then scaled and tilted so it reads at small sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="51"
        android:rotation="30"
        android:scaleX="0.82"
        android:scaleY="0.82">

        <!-- Squeeze marks on either side of the waist. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFD43B"
            android:strokeWidth="3.5"
            android:strokeLineCap="round"
            android:pathData="M79,46 L86,46 M79,56 L86,56 M29,46 L22,46 M29,56 L22,56" />

        <!-- Leaf on the top tip. -->
        <path
            android:fillColor="#FF9ECE6A"
            android:pathData="M55,23 C55,15 61,11 68,11 C68,18 63,23 55,23 Z" />

        <!-- The lemon, pinched in at the middle. -->
        <path
            android:fillColor="#FFFFD43B"
            android:strokeColor="#FFE8A317"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:pathData="M54,21 C57,21 58,24 59,26 C69,28 76,36 76,43 C76,47 71,49 71,51 C71,53 76,55 76,59 C76,68 68,76 59,78 C58,80 57,83 54,83 C51,83 50,80 49,78 C40,76 32,68 32,59 C32,55 37,53 37,51 C37,49 32,47 32,43 C32,36 39,28 49,26 C50,24 51,21 54,21 Z" />

        <!-- Highlight on the upper bulge. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFF2B3"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M39,40 C40,35 44,31 49,30" />
    </group>

    <!-- Juice drops falling from the bottom tip. -->
    <path
        android:fillColor="#FFFFE066"
        android:strokeColor="#FFE8A317"
        android:strokeWidth="1.5"
        android:pathData="M38,73 C38,73 34.5,78 34.5,80 C34.5,82 36,83.5 38,83.5 C40,83.5 41.5,82 41.5,80 C41.5,78 38,73 38,73 Z" />
    <path
        android:fillColor="#FFFFE066"
        android:strokeColor="#FFE8A317"
        android:strokeWidth="1.2"
        android:pathData="M46,79 C46,79 43.8,82.2 43.8,83.4 C43.8,84.6 44.8,85.6 46,85.6 C47.2,85.6 48.2,84.6 48.2,83.4 C48.2,82.2 46,79 46,79 Z" />

    <!-- Terminal prompt, kept upright so it stays readable. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF1A1B26"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M45,46 L51,51.5 L45,57" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF1A1B26"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54.5,57 L62,57" />
</vector>
