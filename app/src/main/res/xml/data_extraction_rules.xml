<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred by Android. Keys and passwords are sealed with a Keystore key that never
  leaves this device, so copied data would be unreadable on the new one. Moving to a new device goes through
  SqueezeSSH's own export/import instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
